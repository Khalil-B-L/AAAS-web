# Modèle des variables lues par docker-compose.yml.
# Copier en .env (non versionné) : cp .env.example .env, puis renseigner les valeurs VIDES.
# Les secrets (et l'e-mail du premier admin) sont volontairement vides : « docker compose up » refuse de démarrer tant qu'ils ne sont pas renseignés
# (syntaxe ${VAR:?message} dans docker-compose.yml). Ne jamais réutiliser une valeur publiée dans un dépôt ou une doc.
#
# Générer une valeur aléatoire :
#   bash/Git Bash : openssl rand -base64 48
#   PowerShell    : [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))

# Mot de passe SA de SQL Server : 8 caractères minimum, avec 3 des 4 catégories (majuscule, minuscule, chiffre, symbole).
# Éviter « ; » et « $ » : ils casseraient la chaîne de connexion ou l'interpolation de compose.
# Une sortie base64 convient (majuscules, minuscules, chiffres) ; en cas de doute, ajouter « -A1 » à la fin.
# ATTENTION : le mot de passe SA est figé à la création du volume sqlserver-data. Pour le changer ensuite :
#   docker compose down -v   (supprime la base locale), puis docker compose up --build -d.
MSSQL_SA_PASSWORD=

# Clé de signature des JWT : au moins 32 octets (256 bits). openssl rand -base64 48 donne 64 caractères.
JWT_SIGNING_KEY=

# Premier administrateur (ADR 0008), créé au premier démarrage s'il n'existe aucun admin.
# E-mail : obligatoire pour compose. Choisir une adresse NON PUBLIÉE (pas celle du site ni d'une affiche) :
# un tiers qui s'inscrirait avant le premier démarrage avec cette adresse bloquerait le démarrage de l'API.
# Mot de passe : au moins 8 caractères dont une lettre et un chiffre ; une sortie base64 convient.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRSTNAME=Admin
BOOTSTRAP_ADMIN_LASTNAME=Association
BOOTSTRAP_ADMIN_PHONE="+216 20 123 456"
# Si un compte existe déjà avec BOOTSTRAP_ADMIN_EMAIL, l'API refuse de démarrer (voir docs/technique/exploitation.md § 5).
# Mettre à true seulement après avoir vérifié que ce compte vous appartient.
BOOTSTRAP_PROMOTE_EXISTING_ACCOUNT=false
